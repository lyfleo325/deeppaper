@echo off
REM ============================================================
REM DeepPaper - Pipeline Wrapper (EXAMPLE)
REM Copy this file to run_pipeline.bat and update paths below
REM ============================================================
REM Set your Python path:
set PYTHON_PATH=C:\path\to\python.exe

REM Install/upgrade deeppaper (includes PyYAML)
"%PYTHON_PATH%" -m pip install -e C:\path\to\deeppaper --quiet

REM Run pipeline (add --push to push to Obsidian)
"%PYTHON_PATH%" -m deeppaper
